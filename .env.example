# Copy this file to .env and fill in real values. .env is gitignored.

# Gemini -- optional. Without a key, classification/description falls back
# to the local keyword table (backend/ml/intake.py::llm_extract).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Lite rejects thinkingConfig, so leave thinking tokens on for it.
GEMINI_NO_THINKING=0

# Telegram bot -- required only to run bot/telegram_bot.py
TELEGRAM_TOKEN=your-bot-token
NAGARAI_API=http://127.0.0.1:8000

# Government dashboard password, typed at /gov. Required -- without it every
# government login fails and the dashboard cannot be reached.
GOV_PASSWORD=change-me

# Shared secret between the Telegram bot and the API. Citizens authenticate
# with a real account (POST /api/auth/signup); the bot is exempt because
# Telegram's own login already proves identity, so it presents this secret
# instead. Generate one with: python3 -c "import secrets; print(secrets.token_hex(24))"
BOT_SHARED_SECRET=change-me

# Server
PORT=8000

# Debugging -- prints exceptions that stages otherwise swallow and degrade past
NAGARAI_DEBUG=1
